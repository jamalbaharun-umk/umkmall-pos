{
  "name": "pos-api",
  "version": "0.0.1",
  "private": true,
  "license": "GPL-3.0-or-later",
  "scripts": {
    "build": "node scripts/bundle-charts.mjs && nest build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --runInBand",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/db/migrate.js"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "drizzle-orm": "^0.45.4",
    "jose": "^5.10.0",
    "pdfkit": "^0.17.2",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "svg-to-pdfkit": "^0.1.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19.3.3",
    "@types/supertest": "^7.0.0",
    "@types/svg-to-pdfkit": "^0.1.5",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "pdf-parse": "^2.4.5",
    "prettier": "^3.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": "(src/.*\\.spec|test/.*\\.e2e-spec)\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "setupFiles": [
      "<rootDir>/test/support/env.ts"
    ],
    "globalSetup": "<rootDir>/test/support/global-setup.ts",
    "testEnvironment": "node"
  }
}
