# Names only; set real values in each service's environment. Never commit a filled-in copy.

# --- pos-api ---
DATABASE_URL=postgres://pos_app:<key>@localhost:5544/pos   # the pos_app role (ops/pos-role.sql)
POS_SESSION_SECRET=                                         # >= 32 chars, the POS's own key
UMKMALL_WEB_URL=https://umkmall.id                          # owner sign-in asks ${UMKMALL_WEB_URL}/api/auth/me (preview: https://preview.umkmall.id)
POS_SERVICE_KEY=                                            # same value as UMKMall's; authenticates POST /internal/tenants/purge
# POS_STORAGE_DIR=.storage
# PORT=3000

# --- payment-api (its own deploy and its own database; never the pos database) ---
# DATABASE_URL=postgres://payment_app:<key>@localhost:5544/payment   # the payment_app role (ops/payment-role.sql)
# PAYMENT_SERVICE_KEY=                                               # >= 16 chars; the same value in every calling service (header X-Payment-Service-Key)
# PORT=3001

# --- pos-web ---
POS_API_URL=http://localhost:3000
UMKMALL_WEB_URL=https://umkmall.id       # UMKMall login page for signed-out owners; unset locally → the POS sign-in page
POS_WEB_URL=https://pos.umkmall.id       # this app's public origin, the login's return address (preview: https://pos.preview.umkmall.id)
# POS_DEV_USER_ID=                       # local only: a public.users id for "Masuk (pengembangan)"
