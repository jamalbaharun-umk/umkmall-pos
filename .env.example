# Names only; set real values in each service's environment. Never commit a filled-in copy.

# --- pos-api ---
DATABASE_URL=postgres://pos_app:<key>@localhost:5544/pos   # the pos_app role (ops/pos-role.sql)
POS_SESSION_SECRET=                                         # >= 32 chars, the POS's own key
UMKMALL_WEB_URL=https://umkmall.id                          # owner sign-in asks ${UMKMALL_WEB_URL}/api/auth/me (preview: https://preview.umkmall.id)
POS_SERVICE_KEY=                                            # same value as UMKMall's; authenticates POST /internal/tenants/purge
POS_AGENT_SERVICE_KEY=                                      # >= 32 chars, UMKMall's agent backend only (POST /auth/agent/session); unset = no agent sessions
POS_TRUSTED_PROXIES=0                                       # hops in front of pos-api that set X-Forwarded-For: count pos-web AND every edge proxy/CDN before it. 0 = none: behind pos-web every device then shares ONE pairing cap
# POS_STORAGE_DIR=.storage
# PORT=3000
# payment-api (UMK-1991). Unset = off: sales complete in one step and nothing is sent (local dev, tests).
# PAYMENT_API_URL=http://localhost:3001     # set = every sale, kasbon payment and void is recorded in payment-api
# PAYMENT_SERVICE_KEY=                      # required with PAYMENT_API_URL; the same value as payment-api's
# PAYMENT_API_TIMEOUT_MS=5000
# PAYMENT_API_ALLOW_HTTP=false              # production needs an https URL; true only when both services share a private network
# POS_PAYMENT_SYNC_MAX_ATTEMPTS=10          # a row payment-api keeps refusing is parked after this many (GET /payment-sync/issues)
# POS_PAYMENT_RECONCILE_INTERVAL_SECONDS=60   # the job that finishes waiting sales and unsent records; 0 = no timer
# POS_PAYMENT_RECONCILE_AFTER_SECONDS=120     # a sale awaiting payment longer than this is looked up and completed or cancelled; >= 2 x the timeout

# --- payment-api (its own deploy and its own database; never the pos database) ---
# DATABASE_URL=postgres://payment_app:<key>@localhost:5544/payment   # the payment_app role (ops/payment-role.sql)
# PAYMENT_SERVICE_KEY=                                               # >= 16 chars; the same value in every calling service (header X-Payment-Service-Key)
# PORT=3001
# Payment-flow settings, all optional (defaults shown; meaning in apps/payment-api/src/config.ts):
# PAYMENT_LATE_AUTO_REFUND=true
# PAYMENT_MANUAL_REFUND_MARK=true
# PAYMENT_QR_TTL_SECONDS=900                 # how long a QR is payable; 60 to 604800 (7 days), never 0 or empty
# PAYMENT_VA_TTL_SECONDS=3600                # how long a virtual account is payable, same bounds (design sample; the owner has not set it)
# PAYMENT_EXPIRY_GRACE_SECONDS=600
# PAYMENT_LATE_SWEEP_SECONDS=3600
# PAYMENT_CANCEL_WITHOUT_GATEWAY_CLOSE=true
# PAYMENT_SYNC_MIN_INTERVAL_SECONDS=5
# PAYMENT_RECONCILE_AFTER_SECONDS=120
# PAYMENT_RECONCILE_INTERVAL_SECONDS=60       # 0 = no timer
# PAYMENT_NOT_FOUND_CONFIRM_SECONDS=60
# PAYMENT_WEBHOOK_MAX_ATTEMPTS=10
# PAYMENT_PURGE_FAILED_REFUND_BLOCK_DAYS=30
# PAYMENT_GATEWAY_MODE=fake                  # fake | sandbox | live: which gateway accounts this environment works with (UMK-2019)
# PAYMENT_LIVE_ENABLED=false                 # the live switch (legal gate UMK-1977): mode live is a boot error without it
# PAYMENT_ADAPTERS=fake                      # LOCAL ONLY: the fake payment gateway (fake_qris, fake_va, /dev/fake-gateway); needs NODE_ENV=development or test, a boot error otherwise

# --- pos-web ---
POS_API_URL=http://localhost:3000
UMKMALL_WEB_URL=https://umkmall.id       # UMKMall login page for signed-out owners; unset locally → the POS sign-in page
POS_WEB_URL=https://pos.umkmall.id       # this app's public origin, the login's return address (preview: https://pos.preview.umkmall.id)
# POS_DEV_USER_ID=                       # local only: a public.users id for "Masuk (pengembangan)"
